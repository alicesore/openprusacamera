[Unit]
Description=openprusacamera setup (apply config)
Wants=NetworkManager.service
After=NetworkManager.service
Before=openprusacamera.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/openprusacamera
ExecStart=/usr/bin/python3 -m openprusacamera.setup

[Install]
WantedBy=multi-user.target
